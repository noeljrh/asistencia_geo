// lib/services/api_service.dart
import 'dart:convert';
import 'package:http/http.dart' as http;
import 'package:shared_preferences/shared_preferences.dart';
import 'auth_service.dart';
import 'queue_service.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter_dotenv/flutter_dotenv.dart';

class ApiService {
  /// Cambia a `true` para pruebas inmediatas sin backend.
  static bool useFake = false;

  // Valores internos que se inicializan explícitamente desde initFromEnv()
  static String? _envBaseUrl;
  static String? _envEndpointPath;

  /// Inicializar ApiService con valores leídos desde dotenv (llamar desde main() después de dotenv.load)
  static Future<void> initFromEnv() async {
    try {
      // Intentar leer desde dotenv si está disponible
      try {
        final api = dotenv.env['API_BASE_URL'];
        final path = dotenv.env['LOCATIONS_PATH'];
        if (api != null && api.isNotEmpty) _envBaseUrl = api;
        if (path != null && path.isNotEmpty) _envEndpointPath = path;
      } catch (e) {
        // Si dotenv no está inicializado o falla, no detener la app; usar fallback más abajo
        debugPrint('ApiService.initFromEnv: flutter_dotenv no disponible o fallo: $e');
      }
    } catch (e) {
      debugPrint('ApiService.initFromEnv error: $e');
    }
  }

  /// URL base de tu API real. Se lee desde la variable interna inicializada o fallback.
  static String get baseUrl =>
      _envBaseUrl ?? 'http://localhost:3000';

  /// Ruta del endpoint de locations. Se lee desde la variable interna inicializada o fallback.
  static String get endpointPath =>
      _envEndpointPath ?? '/api/locations';

  static Future<void> loadFakeModeFromPrefs() async {
    final prefs = await SharedPreferences.getInstance();
    useFake = prefs.getBool('api_use_fake') ?? useFake;
  }

  static Future<void> setFakeMode(bool enabled) async {
    useFake = enabled;
    final prefs = await SharedPreferences.getInstance();
    await prefs.setBool('api_use_fake', enabled);
  }

  /// Construye la URI completa a partir de baseUrl + endpointPath
  static Uri _buildUri() {
    final normalizedBase = baseUrl.endsWith('/')
        ? baseUrl.substring(0, baseUrl.length - 1)
        : baseUrl;
    final normalizedPath =
        endpointPath.startsWith('/') ? endpointPath : '/$endpointPath';
    return Uri.parse('$normalizedBase$normalizedPath');
  }

  /// Envía inmediatamente al servidor (o simula si useFake==true).
  static Future<Map<String, dynamic>> sendLocationNow(
      Map<String, dynamic> payload) async {
    if (useFake) {
      debugPrint('[ApiService] Modo FALSO activo. Payload: ${jsonEncode(payload)}');
      return {'success': true, 'statusCode': 200};
    }

    final uri = _buildUri();
    final token = AuthService.instance.token;
    final headers = <String, String>{
      'Content-Type': 'application/json',
      'Accept': 'application/json',
      if (token != null && token.isNotEmpty) 'Authorization': 'Bearer $token',
    };

    debugPrint(
        'DEBUG: ApiService.sendLocationNow -> POST ${uri.toString()} payload=$payload authTokenPresent=${token != null && token.isNotEmpty}');

    try {
      final res = await http
          .post(uri, body: jsonEncode(payload), headers: headers)
          .timeout(const Duration(seconds: 15));

      debugPrint(
          'DEBUG: ApiService.sendLocationNow response status=${res.statusCode} body=${res.body}');

      if (res.statusCode >= 200 && res.statusCode < 300) {
        return {
          'success': true,
          'statusCode': res.statusCode,
          'data': res.body.isNotEmpty ? jsonDecodeSafe(res.body) : null
        };
      } else if (res.statusCode == 401) {
        try {
          await AuthService.instance.logout();
        } catch (e) {
          debugPrint('DEBUG: ApiService.sendLocationNow logout error: $e');
        }
        return {
          'success': false,
          'statusCode': res.statusCode,
          'error': 'No autorizado (401)',
          'body': res.body
        };
      } else {
        return {'success': false, 'statusCode': res.statusCode, 'error': res.body};
      }
    } catch (e) {
      debugPrint('DEBUG: ApiService.sendLocationNow exception: $e');
      return {'success': false, 'error': e.toString()};
    }
  }

  /// Método público: intenta enviar ahora; si falla, encola y devuelve queueId.
  static Future<Map<String, dynamic>> sendLocation(
      Map<String, dynamic> payload) async {
    debugPrint(
        'DEBUG: ApiService.sendLocation called payload=$payload endpoint=${endpointPath} baseUrl=${baseUrl} useFake=${useFake}');

    final res = await sendLocationNow(payload);
    if (res['success'] == true) {
      return res;
    }

    try {
      await QueueService.instance.init();
      debugPrint('DEBUG: ApiService.sendLocation -> encolando payload=$payload');
      final queueId = await QueueService.instance.add(payload);
      debugPrint('DEBUG: ApiService.sendLocation -> encolado queueId=$queueId');
      return {
        'success': false,
        'error': 'Encolado para reintento',
        'queued': true,
        'queueId': queueId
      };
    } catch (e) {
      debugPrint('DEBUG: ApiService.sendLocation enqueue error: $e');
      return {'success': false, 'error': 'Fallo al encolar: ${e.toString()}'};
    }
  }

  static Future<void> retryQueueItem(String queueId) async {
    await QueueService.instance.init();
    await QueueService.instance.retryNow(queueId);
  }

  /// Helper seguro para parsear JSON sin lanzar
  static dynamic jsonDecodeSafe(String s) {
    try {
      return jsonDecode(s);
    } catch (_) {
      return s;
    }
  }
}

