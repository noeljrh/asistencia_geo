// lib/api/api_client.dart
import 'package:dio/dio.dart';
import 'package:cookie_jar/cookie_jar.dart';
import 'package:dio_cookie_manager/dio_cookie_manager.dart';
import '../auth/auth_state.dart';

class ApiClient {
  final Dio dio;
  final PersistCookieJar cookieJar;

  ApiClient._(this.dio, this.cookieJar);

  factory ApiClient(String baseUrl, AuthState auth) {
    final dio = Dio(BaseOptions(
      baseUrl: baseUrl,
      connectTimeout: const Duration(seconds: 10),
      receiveTimeout: const Duration(seconds: 10),
      headers: {'Content-Type': 'application/json'},
    ));

    final cookieJar = PersistCookieJar(); // para persistir cookies en disco si configuras path
    dio.interceptors.add(CookieManager(cookieJar));

    dio.interceptors.add(InterceptorsWrapper(
      onRequest: (options, handler) {
        final token = auth.accessToken;
        if (token != null) options.headers['Authorization'] = 'Bearer $token';
        options.extra['retry'] = options.extra['retry'] ?? 0;
        return handler.next(options);
      },
      onError: (err, handler) async {
        final response = err.response;
        final reqOptions = err.requestOptions;

        if (response?.statusCode == 401 && (reqOptions.extra['retry'] ?? 0) == 0) {
          try {
            final refreshResp = await dio.post('/api/auth/refresh', options: Options(extra: {'retry': 1}));
            final newToken = refreshResp.data['accessToken'] as String?;
            if (newToken != null) {
              auth.setAccessToken(newToken);

              final opts = Options(
                method: reqOptions.method,
                headers: Map<String, dynamic>.from(reqOptions.headers ?? {})..['Authorization'] = 'Bearer $newToken',
                extra: {...reqOptions.extra, 'retry': 1},
                responseType: reqOptions.responseType,
                contentType: reqOptions.contentType,
              );

              final cloneResp = await dio.request(reqOptions.path,
                  data: reqOptions.data, queryParameters: reqOptions.queryParameters, options: opts);
              return handler.resolve(cloneResp);
            }
          } catch (e) {
            auth.clear();
            return handler.reject(err);
          }
        }

        return handler.next(err);
      },
    ));

    return ApiClient._(dio, cookieJar);
  }
}
